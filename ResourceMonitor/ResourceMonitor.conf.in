#This is the config file that you see in the device

precondition = ["Platform"]
callsign = "org.rdk.ResourceMonitor"
startuporder = "@PLUGIN_RESOURCEMONITOR_STARTUPORDER@"

configuration = JSON()
rootobject = JSON()
rootobject.add("mode", "@PLUGIN_RESOURCEMONITOR_MODE@")
rootobject.add("locator", "lib@PLUGIN_IMPLEMENTATION@.so")
configuration.add("root", rootobject)
