callsign    = "org.rdk.PlaybinPlugin"
autostart   = "@PLUGIN_PLAYBINPLUGIN_AUTOSTART@"
startuporder = "@PLUGIN_PLAYBINPLUGIN_STARTUPORDER@"

configuration = JSON()
rootobject    = JSON()

rootobject.add("mode",    "@PLUGIN_PLAYBINPLUGIN_MODE@")
rootobject.add("locator", "lib@PLUGIN_IMPLEMENTATION@.so")
configuration.add("root", rootobject)
