set(autostart ${PLUGIN_SYSTEMMONITORSUBSCRIBER_AUTOSTART})
set(preconditions Platform)
set(callsign "org.rdk.SystemMonitorSubscriber")

if(PLUGIN_SYSTEMMONITORSUBSCRIBER_STARTUPORDER)
set(startuporder ${PLUGIN_SYSTEMMONITORSUBSCRIBER_STARTUPORDER})
endif()

map()
    key(root)
    map()
        kv(mode    ${PLUGIN_SYSTEMMONITORSUBSCRIBER_MODE})
        kv(locator lib${PLUGIN_IMPLEMENTATION}.so)
    end()
end()

ans(configuration)
