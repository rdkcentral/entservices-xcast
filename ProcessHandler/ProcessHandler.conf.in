#This is the config file that you see in the device

precondition  = ["Platform"]
callsign      = "org.rdk.ProcessHandler"
startuporder  = "@PLUGIN_PROCESSHANDLER_STARTUPORDER@"

configuration = JSON()
rootobject    = JSON()

rootobject.add("mode",    "@PLUGIN_PROCESSHANDLER_MODE@")
rootobject.add("locator", "lib@PLUGIN_IMPLEMENTATION@.so")
configuration.add("root", rootobject)
